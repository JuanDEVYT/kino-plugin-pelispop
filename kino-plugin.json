{
  "id": "pelispop",
  "name": "PelisPop",
  "version": "1.1.7",
  "apiVersion": 8,
  "entry": "plugin.js",
  "icon": "icon.png",
  "color": "#03c1ef",
  "description": "Películas, series y anime de PelisPop en español latino con interfaz declarativa completa y servidores de reproducción rápida HLS.",
  "author": "JuanDEVYT",
  "homepage": "https://github.com/JuanDEVYT/kino-plugin-pelispop",
  "browser": true,
  "hosts": [
    "pelispop.mov",
    "embed69.org",
    "repelisplus.my",
    "watchfun.top",
    "nupload.my",
    "sv3.ibra.lat",
    "cnddim.xyz",
    "api.themoviedb.org",
    "image.tmdb.org",
    "raw.githubusercontent.com",
    "ibra.lat",
    "sv1.ibra.lat",
    "sv2.ibra.lat",
    "sv4.ibra.lat",
    "sv5.ibra.lat",
    "sv6.ibra.lat",
    "sv7.ibra.lat",
    "sv8.ibra.lat",
    "vidsrc.to",
    "vidsrc.me"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "categories": [
    "movies",
    "series",
    "anime"
  ],
  "section": {
    "label": "PelisPop",
    "labelEn": "PelisPop"
  },
  "enhancements": {
    "14": {
      "capabilities": [
        "screen"
      ],
      "screen": {
        "label": "PelisPop",
        "labelEn": "PelisPop",
        "icon": "movie",
        "menuOpens": "screen",
        "opensFrom": [
          "menu",
          "settings"
        ],
        "settingsButton": {
          "label": "Abrir PelisPop",
          "labelEn": "Open PelisPop"
        }
      }
    },
    "19": {
      "capabilities": [
        "screen"
      ]
    }
  },
  "settings": [
    {
      "key": "generalSection",
      "type": "section",
      "label": "Configuración General",
      "labelEn": "General Settings"
    },
    {
      "key": "serverPreference",
      "type": "select",
      "default": "hls",
      "label": "Servidor de vídeo",
      "labelEn": "Video Server",
      "hint": "Servidor principal para reproducir enlaces.",
      "hintEn": "Main server used for video streaming.",
      "options": [
        {
          "value": "hls",
          "label": "HLS Rápido Latino (Recomendado)",
          "labelEn": "Fast HLS Latino (Recommended)"
        },
        {
          "value": "embed69",
          "label": "Embed69",
          "labelEn": "Embed69"
        }
      ]
    },
    {
      "key": "openPortal",
      "type": "action",
      "label": "Abrir portal PelisPop",
      "labelEn": "Open PelisPop Portal"
    }
  ]
}
