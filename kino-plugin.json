{
  "id": "pelispop",
  "name": "PelisPop",
  "version": "2.0.3",
  "apiVersion": 8,
  "entry": "plugin.js",
  "icon": "icon.png",
  "color": "#03c1ef",
  "description": "Películas, series y anime de PelisPop en español latino. Motor v2: resolución directa voe.sx sin loops ni timeouts.",
  "author": "JuanDEVYT",
  "homepage": "https://github.com/JuanDEVYT/kino-plugin-pelispop",
  "browser": true,
  "hosts": [
    "pelispop.mov",
    "repelisplus.my",
    "watchfun.top",
    "nupload.my",
    "voe.sx",
    "embed69.org",
    "image.tmdb.org",
    "raw.githubusercontent.com"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "categories": [
    "movies",
    "series",
    "anime"
  ],
  "section": {
    "label": "PelisPop",
    "labelEn": "PelisPop"
  },
  "enhancements": {
    "14": {
      "capabilities": [
        "screen"
      ],
      "screen": {
        "label": "PelisPop",
        "labelEn": "PelisPop",
        "icon": "movie",
        "menuOpens": "screen",
        "opensFrom": [
          "menu",
          "settings"
        ],
        "settingsButton": {
          "label": "Abrir PelisPop",
          "labelEn": "Open PelisPop"
        }
      }
    },
    "19": {
      "capabilities": [
        "screen"
      ]
    }
  },
  "settings": [
    {
      "key": "generalSection",
      "type": "section",
      "label": "Configuración General",
      "labelEn": "General Settings"
    },
    {
      "key": "openPortal",
      "type": "action",
      "label": "Abrir portal PelisPop",
      "labelEn": "Open PelisPop Portal"
    }
  ]
}
